{
  "name": "github-hot-recommend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每天自动从 GitHub 挑选热门项目，生成中文推荐稿并展示",
  "scripts": {
    "build": "tsx src/build.ts",
    "fetch": "tsx src/fetch.ts",
    "serve": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
