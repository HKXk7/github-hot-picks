# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但模板要进仓库：新机器 clone 下来第一件事就是照着它建 .env
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/generated/prisma

# sqlite database files
*.db
*.db-journal
*.db-wal
*.db-shm

# 本地 dev server 日志
.next-dev.*.log

# 本地草稿与一次性调试脚本（不进仓库）
today-picks.md
scripts/_probe_auth.py
scripts/_reenable_plugin.py
build.log
dev.log

# 部署时注入的运行时环境变量（可能含令牌，绝不入库）
.deploy-env

# DSH 插件属于本机 Harness 配置，不是本站代码
/dsh-plugin/
