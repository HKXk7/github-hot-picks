// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 抓取到的 GitHub 项目
model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  name        String
  fullName    String   @unique
  description String?
  url         String
  language    String?
  stars       Int
  forks       Int
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  // AI 生成的小白教程（Markdown），教新手「它是什么 / 怎么装 / 怎么用」
  tutorial    String?

  // ── 教程生成失败的记录 ──────────────────────────────────────────
  // 之前生成失败只是打一行 warn，然后这个项目就被推荐出去了：
  // 它进了历史去重名单，永远不会再被选中，于是「缺教程」是永久的。
  // 记下原因和次数，才能在下期自动补做，也才能回答「为什么它没有教程」。
  // 注意 attempts 记的是「跑过几期」，不是单次生成内部那 3 次重试
  // （generate.ts 里的 MAX_ATTEMPTS 是一次生成内的自我修复）。
  tutorialError    String?
  tutorialAttempts Int       @default(0)
  tutorialFailedAt DateTime?

  recommendations Recommendation[]
}

// 2. 每周推荐稿
model Article {
  id          String   @id @default(cuid())
  issue       Int      @unique
  title       String
  content     String
  status      String   @default("draft")
  weekStart   DateTime
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  recommendations Recommendation[]
}

// 3. 推荐关系（稿子 ↔ 项目，多对多）
model Recommendation {
  id           String     @id @default(cuid())
  article      Article    @relation(fields: [articleId], references: [id])
  articleId    String
  repository   Repository @relation(fields: [repositoryId], references: [id])
  repositoryId String
  reason       String?
  category     String?
  sortOrder    Int

  @@unique([articleId, repositoryId])
}

// 5. RAG 知识库切片
// 把已有教程 / 项目简介切成可检索的片段，供 AI 检索（search_knowledge 工具）使用。
// embedding 存的是 bge-m3 的 1024 维向量，序列化成 JSON 数组字符串
// ——SQLite 没有原生向量类型，几百条数据用暴力余弦相似度完全够，
// 不值得为此引入 pgvector / sqlite-vec 这类额外依赖。
model KnowledgeChunk {
  id           String   @id @default(cuid())
  repoFullName String
  // tutorial | description | readme
  source       String
  content      String
  tokens       Int      @default(0)
  embedding    String?
  embeddedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 同一个项目的同一种来源只保留一条，重建索引时是 upsert 而非无限堆积
  @@unique([repoFullName, source])
  @@index([repoFullName])
}

// 6. 每一次 LLM 调用的用量与耗时
// 没有这张表，「一次教程生成花多少钱 / 哪一步最慢 / 上游是不是开始报错」
// 这三个问题就都只能靠猜。它是成本控制和线上排查的唯一依据，
// 所以写入必须「尽力而为」——观测把主流程拖垮是最糟的失败模式。
model LlmCall {
  id               String   @id @default(cuid())
  // 同一次生成/同一次对话里的多次调用共用一个 traceId，才能回答「哪一步最慢」
  traceId          String
  // tutorial | chat | embed | planner | eval
  kind             String
  // 具体是哪一步，例如 fetch_readme、self-repair
  label            String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  // 按写入时的单价表折算，单价会变，所以存下来而不是事后重算
  costCny          Float?
  latencyMs        Int
  ok               Boolean
  error            String?
  // 降级手段（如「该模型不支持 response_format」）的 JSON 数组
  degraded         String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([traceId])
  @@index([kind])
}

// 7. AI Buddy 的会话与消息
// 之前会话只存在浏览器 localStorage 里：换个设备、清个缓存就没了，
// 服务端也完全不知道用户问过什么。挪到库里才能做多轮记忆和滚动摘要。
model ChatSession {
  id        String   @id @default(cuid())
  title     String?
  // 较早那部分对话的滚动摘要：不这么做，上下文会随轮数无限增长，
  // 迟早把 token 上限和额度一起吃掉
  summary       String?
  summarizedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// 4. 定时任务运行记录
model JobRun {
  id        String    @id @default(cuid())
  jobType   String
  status    String
  log       String?
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}
