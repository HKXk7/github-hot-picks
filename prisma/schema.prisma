// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 抓取到的 GitHub 项目
model Repository {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  name        String
  fullName    String   @unique
  description String?
  url         String
  language    String?
  stars       Int
  forks       Int
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  // AI 生成的小白教程（Markdown），教新手「它是什么 / 怎么装 / 怎么用」
  tutorial    String?

  recommendations Recommendation[]
}

// 2. 每周推荐稿
model Article {
  id          String   @id @default(cuid())
  issue       Int      @unique
  title       String
  content     String
  status      String   @default("draft")
  weekStart   DateTime
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  recommendations Recommendation[]
}

// 3. 推荐关系（稿子 ↔ 项目，多对多）
model Recommendation {
  id           String     @id @default(cuid())
  article      Article    @relation(fields: [articleId], references: [id])
  articleId    String
  repository   Repository @relation(fields: [repositoryId], references: [id])
  repositoryId String
  reason       String?
  category     String?
  sortOrder    Int

  @@unique([articleId, repositoryId])
}

// 5. RAG 知识库切片
// 把已有教程 / 项目简介切成可检索的片段，供 AI 检索（search_knowledge 工具）使用。
// embedding 存的是 bge-m3 的 1024 维向量，序列化成 JSON 数组字符串
// ——SQLite 没有原生向量类型，几百条数据用暴力余弦相似度完全够，
// 不值得为此引入 pgvector / sqlite-vec 这类额外依赖。
model KnowledgeChunk {
  id           String   @id @default(cuid())
  repoFullName String
  // tutorial | description | readme
  source       String
  content      String
  tokens       Int      @default(0)
  embedding    String?
  embeddedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 同一个项目的同一种来源只保留一条，重建索引时是 upsert 而非无限堆积
  @@unique([repoFullName, source])
  @@index([repoFullName])
}

// 4. 定时任务运行记录
model JobRun {
  id        String    @id @default(cuid())
  jobType   String
  status    String
  log       String?
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}
