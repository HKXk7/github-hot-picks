# 统一换行符：仓库内一律存 LF，检出时按平台自动转换
# 不加的话，Windows 上提交、Linux 上改动会导致 diff 显示整个文件被重写
* text=auto

# shell 脚本一律 LF：部署沙箱是 Linux，行尾带 \r 会让 bash 直接报 syntax error
*.sh text eol=lf

# 二进制文件，禁止做任何换行符/文本转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.wasm binary
*.node binary
*.db   binary
